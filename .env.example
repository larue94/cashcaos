# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/gojiberry"

# ── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"

# ── Redis (BullMQ) ────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── LLM Providers (set at least one) ─────────────────────────────────────────
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# Which provider to use: "anthropic" | "openai"
LLM_PROVIDER="anthropic"
# Model names
ANTHROPIC_MODEL="claude-sonnet-4-6"
OPENAI_MODEL="gpt-4o"

# ── Email Channel ─────────────────────────────────────────────────────────────
# Gmail OAuth2
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_FROM_ADDRESS=""

# Outlook / Microsoft Graph OAuth2
OUTLOOK_CLIENT_ID=""
OUTLOOK_CLIENT_SECRET=""
OUTLOOK_TENANT_ID=""
OUTLOOK_REFRESH_TOKEN=""

# Resend (transactional email — fallback/alternative)
RESEND_API_KEY=""
RESEND_FROM_ADDRESS=""

# SendGrid
SENDGRID_API_KEY=""
SENDGRID_FROM_ADDRESS=""

# Which email adapter to use: "gmail" | "outlook" | "resend" | "sendgrid" | "mock"
EMAIL_PROVIDER="mock"

# ── Enrichment Providers ──────────────────────────────────────────────────────
# Apollo.io
APOLLO_API_KEY=""

# Clearbit
CLEARBIT_API_KEY=""

# People Data Labs
PDL_API_KEY=""

# Which enrichment adapter: "apollo" | "clearbit" | "pdl" | "mock"
ENRICHMENT_PROVIDER="mock"

# ── CRM Connectors ────────────────────────────────────────────────────────────
# HubSpot
HUBSPOT_ACCESS_TOKEN=""
HUBSPOT_PORTAL_ID=""

# Pipedrive
PIPEDRIVE_API_KEY=""
PIPEDRIVE_COMPANY_DOMAIN=""

# Which CRM adapter: "hubspot" | "pipedrive" | "mock"
CRM_PROVIDER="mock"

# ── Signal / Webhook ─────────────────────────────────────────────────────────
# A shared secret for the inbound webhook endpoint POST /api/webhooks/signals
WEBHOOK_SIGNAL_SECRET="change-me"

# ── App settings ─────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
