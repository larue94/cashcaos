# ------------------------------------------------------------------
# SETTINGS FILE TEMPLATE
# Copy this file, name the copy exactly:  .env
# then fill in your keys after the = signs (no quotes, no spaces).
# The .env file stays on your computer only — it is never uploaded.
# ------------------------------------------------------------------

# --- Needed for Phase 1 ---
# From https://alpaca.markets -> Paper dashboard -> API Keys
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- Needed from Phase 2 (news sentiment) ---
# Free key from https://finnhub.io (sign up, key is on your dashboard)
FINNHUB_API_KEY=

# --- Needed from Phase 3 (AI reasoning) ---
# From https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# --- Open-source model for grunt work (LOW tier) ---
# Option 1 (default, hosted, free tier): Groq — free key from
# https://console.groq.com, paste it here:
LLM_LOW_API_KEY=

# Option 2 (runs on YOUR computer, fully free/private): Ollama — install from
# https://ollama.com, run `ollama pull llama3.1:8b`, then uncomment:
#LLM_LOW_BASE_URL=http://localhost:11434/v1
#LLM_LOW_MODEL=llama3.1:8b

# --- Optional: model choices (sensible defaults if left alone) ---
# HIGH tier = judgment calls (trade reasoning, daily digest, weekly review)
#LLM_HIGH_MODEL=claude-opus-4-8
# LOW tier = grunt work (headline summaries, catalyst extraction)
#LLM_LOW_MODEL=llama-3.3-70b-versatile

# --- Telegram bot (phone alerts + Approve/Reject buttons) ---
# Create a bot: open Telegram, message @BotFather, send /newbot, follow the
# prompts, paste the token it gives you here:
TELEGRAM_BOT_TOKEN=
# Leave blank — the first person to send /start to the bot becomes the owner.
# (Or set it to lock the bot to one chat id.)
#TELEGRAM_CHAT_ID=
# Local time (24h) to auto-run the daily analysis on weekdays:
#TELEGRAM_DIGEST_TIME=09:45

# --- Optional: confidence discipline ---
# Skip any recommendation below this bar; conviction also scales position size
# (high = full, medium ~66%, low ~40%). Options: low / medium / high.
#MIN_CONFIDENCE=medium

# --- Optional: safety stop-loss (per-position) ---
# Sell a holding if it falls this far below your entry, regardless of trend.
# 0 disables it. Core books default 15%; the small-cap sleeve gets 30%.
#STOP_LOSS_PCT=0.15
#STOP_LOSS_PCT_SMALLCAP=0.30
