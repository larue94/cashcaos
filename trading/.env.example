# ------------------------------------------------------------------
# SETTINGS FILE TEMPLATE
# Copy this file, name the copy exactly:  .env
# then fill in your keys after the = signs (no quotes, no spaces).
# The .env file stays on your computer only — it is never uploaded.
# ------------------------------------------------------------------

# --- Needed for Phase 1 ---
# From https://alpaca.markets -> Paper dashboard -> API Keys
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- Needed from Phase 2 (news sentiment) ---
# Free key from https://finnhub.io (sign up, key is on your dashboard)
FINNHUB_API_KEY=

# --- Needed from Phase 3 (AI reasoning) ---
# From https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
